run = "npm start"
entrypoint = "src/index.js"
modules = ["nodejs-24"]

[nix]
channel = "stable-25_11"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "corepack enable && corepack pnpm install"]
run = ["sh", "-c", "npm start"]

[[ports]]
localPort = 8080
externalPort = 80

[debugger]
support = false
